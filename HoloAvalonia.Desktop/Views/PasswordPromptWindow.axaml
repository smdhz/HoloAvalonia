<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HoloAvalonia.Views"
        x:Class="HoloAvalonia.Views.PasswordPromptWindow"
        x:DataType="views:PasswordPromptWindow"
        Width="420"
        Height="180"
        MinWidth="380"
        MinHeight="170"
        Title="API Login Required"
        Icon="avares://HoloAvalonia/Resources/suisei.ico"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource HoloAppBackgroundBrush}">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Please enter API password:" />
        <TextBox x:Name="PasswordInput"
                 PasswordChar="*"
                 Text="idhHZMql4FTPd7s"
                 PlaceholderText="Password" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Cancel"
                    Click="CancelButton_Click" />
            <Button Content="Login"
                    Click="LoginButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
